#!name=YouTube Adblock Diagnostic
#!desc=Maasea 基准兼容模式；oad 空响应；Protobuf 去广告/后台/PiP；不同时启用 UMP。
#!version=1.4.0
#!author=Maasea; compatibility adaptation: hmxxgit
# Sources, original licenses and exact snapshot: NOTICE.md and vendor/
# Script revision: aaa556d830563ee50d4ab07035bef83ff5183bac; Temporary diagnostic mode enabled; disable the normal module first.
# Disable other YouTube modules; do not combine this profile with UMP interception.

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

[Script]
youtube.adblock.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=auto,timeout=60,argument=diagnostic=true,script-path=https://raw.githubusercontent.com/hmxxgit/shadowrocket-youtube-adblock/aaa556d830563ee50d4ab07035bef83ff5183bac/scripts/youtube.response.compat.js?v=1.4.0

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com
