#!name=YouTube Adblock Diagnostic
#!desc=保留正常初始化；按需 Protobuf 去广告/后台/PiP；诊断耗时默认关闭。
#!version=1.5.0
#!author=Maasea; compatibility adaptation: hmxxgit
# Sources, original licenses and exact snapshot: NOTICE.md and vendor/
# Script revision: 1c1184a450e0bf2f5e770386522e5acdbda1177c; Temporary diagnostic mode enabled; disable the normal module first.
# Disable other YouTube modules; do not combine this profile with UMP interception.

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads|initplayback(?:[/?]|$)).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?|initplayback(?:[/?]|$))).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

[Script]
youtube.adblock.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,timeout=60,argument=diagnostic=true,script-path=https://raw.githubusercontent.com/hmxxgit/shadowrocket-youtube-adblock/1c1184a450e0bf2f5e770386522e5acdbda1177c/scripts/youtube.response.compat.js?v=1.5.0

youtube.timing.request = type=http-request,pattern=^https:\/\/(?:youtubei\.googleapis\.com\/youtubei\/v1\/(?:player|get_watch)|[\w-]+\.googlevideo\.com\/initplayback)(?:\?[^#]*)?$,requires-body=0,engine=jsc,timeout=5,argument=diagnostic=true&phase=request,script-path=https://raw.githubusercontent.com/hmxxgit/shadowrocket-youtube-adblock/1c1184a450e0bf2f5e770386522e5acdbda1177c/scripts/youtube.timing.js?v=1.5.0
youtube.timing.init.response = type=http-response,pattern=^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$,requires-body=0,engine=jsc,timeout=5,argument=diagnostic=true&phase=response,script-path=https://raw.githubusercontent.com/hmxxgit/shadowrocket-youtube-adblock/1c1184a450e0bf2f5e770386522e5acdbda1177c/scripts/youtube.timing.js?v=1.5.0

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com
